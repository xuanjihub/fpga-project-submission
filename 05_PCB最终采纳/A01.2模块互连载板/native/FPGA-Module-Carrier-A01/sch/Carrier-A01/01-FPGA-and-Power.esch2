{"type":"TEXT","ticket":3977,"id":"80248b35bd2af502"}||{"x":65,"y":259,"rotation":0,"color":"#16324F","fontFamily":"Arial","fontSize":10,"fontWeight":false,"italic":false,"underline":false,"align":"LEFT_TOP","value":"Partition by placement: sensor/FSR, panel/OLED and PCM. Do not route digital return through FSR reference.","fillColor":"#16324F","zIndex":169,"yAxisDirection":"up"}|
{"type":"TEXT","ticket":3978,"id":"1b861023e3a15484"}||{"x":65,"y":245,"rotation":0,"color":"#16324F","fontFamily":"Arial","fontSize":10,"fontWeight":false,"italic":false,"underline":false,"align":"LEFT_TOP","value":"All connector pin numbers are carrier-board pins. Check each cable against module silk before assembly.","fillColor":"#16324F","zIndex":170,"yAxisDirection":"up"}|
{"type":"TEXT","ticket":3979,"id":"55ef43990950ef28"}||{"x":65,"y":231,"rotation":0,"color":"#16324F","fontFamily":"Arial","fontSize":10,"fontWeight":false,"italic":false,"underline":false,"align":"LEFT_TOP","value":"J1.29/30 are NC (optional SDRAM signals), NOT power. Unused J1 pins carry explicit NC marks.","fillColor":"#16324F","zIndex":171,"yAxisDirection":"up"}
